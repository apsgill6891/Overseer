# Local development only. Never enable this in a shared environment.
OVERSEER_DEV_MODE=0

# Inject from a secret manager. The identity proxy must strip client-supplied
# X-Overseer-* headers before adding verified identity.
OVERSEER_PROXY_SECRET=replace-with-at-least-32-random-bytes

# Phase 2 production target. The current zero-dependency service uses SQLite;
# the PostgreSQL migration contract is in server/postgres/schema.sql.
DATABASE_URL=postgresql://overseer:change-me@postgres:5432/overseer
